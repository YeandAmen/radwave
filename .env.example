RADAR_ADDR=127.0.0.1:8080
RADAR_DB=data/radar.db
RADAR_INTERVAL=30m
RADAR_AUTO_CRAWL=true
RADAR_REQUEST_DELAY=2s
RADAR_HTTP_TIMEOUT=25s
# Set a token to enable management when listening beyond localhost.
RADAR_ADMIN_TOKEN=
# Hosted Vercel deployment: provided by the Neon integration.
DATABASE_URL=
# App-scoped secret shared by Vercel and the GitHub refresh workflow.
CRON_SECRET=
# Optional X / Twitter API ingestion; requires endpoint access and API credits.
X_BEARER_TOKEN=
